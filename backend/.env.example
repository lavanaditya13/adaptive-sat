# App Settings
PROJECT_NAME="Adaptive SAT Learning Platform"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Security
SECRET_KEY="super-secret-temporary-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=11520  # 8 days

# PostgreSQL Database Connections
# Format: postgresql+asyncpg://user:password@host:port/dbname
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=adaptive_sat

# Async Database URL for application use
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/adaptive_sat

# Sync Database URL for alembic migrations (if needed, or alembic can use async with asyncpg)
SYNC_DATABASE_URL=postgresql://postgres:postgres@db:5432/adaptive_sat
