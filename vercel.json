{
  "git": {
    "deploymentEnabled": {
      "main": true,
      "develop": true
    }
  },
  "builds": [
    { "src": "backend/index.py", "use": "@vercel/python" },
    { "src": "frontend/package.json", "use": "@vercel/static-build", "config": { "distDir": "apps/web/dist" } }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "backend/index.py" },
    { "src": "/(.*)", "dest": "/frontend/$1", "continue": true },
    { "handle": "filesystem" },
    { "src": "/frontend/(.*)", "dest": "/frontend/index.html" }
  ]
}
